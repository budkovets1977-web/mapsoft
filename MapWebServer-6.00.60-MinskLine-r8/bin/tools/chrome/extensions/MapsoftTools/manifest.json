{
	"manifest_version": 2,
	"minimum_chrome_version": "46.0",
  	"offline_enabled": true,
	"name": "Mapsoft Tools",
	"description": "Помощник для веб приложений Mapsoft",
	"version": "0.0.5",
	"icons": {
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"browser_action": {
		"default_icon": "icons/48.png"
	},
	"options_ui": {
    	"page": "options.html",
    	"open_in_tab": false
  	},
	"permissions": ["activeTab", "management", "storage"],
	"background": {
		"page": "background.html",
		"persistent": false
	},
	"content_scripts": [{
		"matches": ["<all_urls>"],
		"js": ["js/content.js"]
	}, {
		"all_frames": true,
		"matches": ["file:///*"],
		"js": ["js/iframe.js"],
		"run_at": "document_idle"
	}]
}
