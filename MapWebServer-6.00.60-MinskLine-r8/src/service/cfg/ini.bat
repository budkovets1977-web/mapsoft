@rem Настройка параметров службы веб-сервера.
@chcp 866 >nul
@echo off

if %1==setup (

rem Название сервиса в Windows. 
SET ServiceName=MapWebServer

rem Базовый IP-адрес через который будет обеспечиваться доступ к веб-серверу, без порта. 
rem Этот адрес будет использоваться для генерации ключа самозаверенного сертификата SSL.
SET ServerName=192.168.101.100

rem Доменное имя сайта через которое будет обеспечиваться доступ к веб-серверу. 
rem Если не указано, то будет использован IP-адрес ServerName, иначе доменное имя
rem приоритетнее. Без порта, например example.com, mis.mapsoft.by.
rem Это имя будет использоваться для генерации ключа самозаверенного сертификата SSL.
rem SET DomainName=cmis.by

rem Включить режим работы по незащищенному соединению HTTP.
rem Чтобы выключить, надо стереть значение "true" или закомментировать (rem) строку.
SET EnableHTTP=true

rem Включить режим работы по защищенному соединению HTTP.
rem Чтобы выключить, надо стереть значение "true" или закомментировать (rem) строку.
rem При выключенном параметре, некоторые задачи и функции будут недоступны.
SET EnableSSL=true

rem Порт HTTP доступа к серверу.
rem Стандартный 80 - не требует указания порта в адресной строке браузера.
SET ServerPort=8080

rem Порт HTTPS для защищенного доступа к серверу.
rem Стандартный 443 - не требует указания порта в адресной строке браузера.
SET SSLPort=8443

rem Принудительно перенаправлять запросы HTTP на HTTPS. Работает только со стандартными
rem портами 80 и 443. При включении опции обязательно включить EnableHTTP и EnableSSL.
rem Чтобы выключить, надо стереть значение "true" или закомментировать (rem) строку.
SET RedirectHTTP=

rem Настройка прокси сервера для передачи в реальном времени электронных рецептов в ЦОД
rem из локальной сети. Для включения раскомментарить два нижних строки и указать IP и
rem порт прокси-сервера.
rem В настройках МАП прописать адрес веб-сервера ЦОД http://HOST:PORT/api/fhir/ а в адрес
rem сервера авторизации http://HOST:PORT/auth/connect/token
rem SET EHR_ProxyHost=192.168.101.100
rem SET EHR_ProxyPort=8082

rem Настройка доступа к центральному PACS Orthanc для просмотра снимков.
rem Чтобы выключить, надо стереть значение или закомментировать (rem) строку.
rem SET PACS_OrthancUrl=http://127.0.0.1:8042

) else (

echo.
echo Настройка параметров службы веб-сервера.
echo.
echo Данный файл не требует запуска. С помощью редактора измените в этом файле
echo параметры запуска службы.
echo После изменения выполните uninstall.bat/install.bat в корне веб-сервера.
echo.
pause

)
