/*
    Настройка инфокиоска выдачи талонов (Регистратура).
    Важен регистр названий параметров.
*/
{
    /* Настройка подключения */
    "connect": {
        /*
          Тип подключения. Возможные варианты:
            "map" - подключение к БД МАП, строка подключения будет браться из файла настроек конфигурация config.json;
            "belcmt" - подключение к службе БелЦМТ, настройка подключения будет ниже в разделе "belcmt".
        */
        "type": "map",

        /* Разные настройки подключения к БД МАП */
        "map": {
            "currentEnterpriseId":      1,  /* Код текущей организации */
            "enterpriseStructureId":    0   /* Код подразделения. 0 - Без фильтрации */
        },

        /* Настройка подключения к сервису БелЦМТ */
        "belcmt": {
            "url": "http://999.999.999.999:9999/info/index.php", /* Ссылка для подключения к веб-службе БелЦМТ */
            "calendarMonths": 6 /* Количество месяцев на которое отображаются талоны врачей от текущей даты. */
        },
        /*
          Дополнительные параметры к прокси-серверу, для подключения к другим сервисам (БелЦМТ).
        */
        "proxy": {
            "host": null,
            "port": null,
            "user": null,
            "pass": null
        }
    },

    "print": {
        "osapi": "http://127.0.0.1:7943"    // Адрес и порт сервера осапи. Используется для печати талона.
    },

    "showMouse":            0,              // Отображение курсора мыши, для отладки
    "debug":                0,              // Режим отладки. Выводит в консоль различные сообщения о работе приложения.
    "info": {
        "path": "shared/talonbox/info/index.html",  // Путь стартовой страницы 'Информация' (должно лежать относительно прописанного Alias в httpd.conf)
        "fontSizeDelta":    -2                      // Этим параметром можно менять размер шрифта, если нужно (+ увеличение, - уменьшение).
    },

    "maxActiveCoupons":     5,              // Максимальное количество талонов для выдачи

    "ordersValidityMonths": 3,              // Срок актуальности назначений (в месяцах)

    /* Счетчики */
    "timers": {
        "refresh":          60,             // сек., Период обновления главного экрана
        "inactive":         60,             // сек., Время бездействия пользователя
        "inactiveLogin":    15,             // сек., Время бездействия пользователя при логине
        "finish":           30              // сек., Последний экран, время, через которое вернуться на главный экран
    },

    "buttonsDisableTime":   5,              // сек., Экран печати талона. Время блокировки кнопок после нажатия для ограничения повторного нажатия

    "mainLogo":             1,              // 1 - Mapsoft, 2 - eDoctor

