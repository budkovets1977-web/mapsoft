/* Настройки задачи Электронная очередь */
{
    /* Перечень инфокиосков электронной очереди */
    "infoboxes": {
        "Лаборатория": {
            /* Длина штрих-код */
            "barcodeLength": 16,

            /* Счетчики времени выполнения действий (сек.) */
            "interval": {
                /* Обновления списка услуг (первый экран) */
                "refresh": 300,

                /* Бездействие пользователя */
                "wait": 10,

                /* Время отоброжения последнего экрана */
                "finish": 60
            },

            /* Тексты ошибок */
            "errors": {
                "categoryIsNotProvided": "Обслуживание пациентов указанной категории не предусматривается",
                "couponOverQuota": "Исчерпан лимит талонов для данной услуги",
                "workExpired": "Рабочее время для выбранной услуги истекло",
                "waitExceeded": "Превышено число ожидающих в очереди"
            },

            /* Языковые переменные */
            "lang": {
                "noServices": "Приём окончен"
            },

            /* Инструменты */
            "tools": {
                /* Имя хоста и(или) порт OSAPI сервера для выполнения различных системных операций в операционной системе */
                "osapi": "http://127.0.0.1:7943"
            },

            /* Льготники */
            "priorityQueue": {
                "title": "Я - льготник",
                "usingAuthorizationConfiguration": 1, /* 1 - с авторизацией, 0 - без авторизации */
                "noteForUsingAuthorization": "Авторизуйтесь по ФИО или штрихкоду",
                "noteForNoAuthorization": "получите льготный талон"
            },

            /* Короткий код */
            "shortCode": {
                "usingShortCode": 1, /* 1 - с отображением короткого кода, 0 - без отображения короткого кода */
                "optionName": "Короткий номер - авторизуйтесь по ФИО или штрихкоду карты обслуживания",
                "optionNote": "полученный на talon.by или указанный в направлении"
            }
        }
    },

    /* Наименования конфигурации для подключения к БД из RESTFul-сервера (api.php) */
    "apiConfig": "equeue_test"
}