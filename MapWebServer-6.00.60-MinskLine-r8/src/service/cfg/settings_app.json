/* Настройки всех приложений */
{
    /* адрес и порт сервера веб-ассистента */
    "webAssistUrl": "http://127.0.0.1:7376",
    
    /* порт OSAPI сервера для печати, например талонов */
	"osapiPrintPort": 7943,

	/* время (секунд) ожидания активности пользователя, до закрытия сессии */
	"appTimeout": 900,

	/* время (секунд) отображения сообщения, с информацией о скором закрытии сессии */
	"appTimeoutMessageDelay": 60,

	/* путь к exe MAP для удаленной генерации отчетов */
	"mapBin": "d:\\MAP\\trunk\\Bin",
    
	"talonEnterpriseCode": 1
}