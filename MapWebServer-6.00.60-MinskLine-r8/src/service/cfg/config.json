// Список конфигураций поддерживаемых данным веб-сервером.
// Конфигурацией является одна или несколько задач, имеющих подключение к одной
// базе данных и единой авторизацией пользователей. Например, если у заказчика
// несколько баз данных МАП, то это будут разные конфигурации, так как нужно
// выбрать из какой БД выбирать веб-пользователей.
// Если конфигураций несколько, при обращении к стартовой страницы, отобразится
// данный список, и только после выбора будет выполнена авторизация пользователя.
// Если конфигурация одна, вход будет автоматический.
// Также автоматический вход в нужную конфигурацию можно осуществлять через
// параметры адресной строки, например: www.example.com/?config=med,
// что позволит сделать закладки или ярлыки для быстрого входа.
{
    // Название конфигурации. Должно быть уникальным в пределах одного
	// запущенного сервера и данного файла конфигураций.
    // Разрешены латинские буквы, цифры, точка и подчеркивание.
    // Запрещены зарезервированные слова config, configs.
	"mis": {
        // Задача с которой стартуется данная конфигурация. Древо названий задач
        // и групп находится в файле cfg/apps.txt. Пользователю будут
        // доступны все связанные задачи с данной (в соответствии с разрешениями
        // регистрации). Дополнительные ограничения по доступу можно указать в
        // параметре "apps".
        // Если параметр "app" не указан, то это специальная конфигурация
        // дополнительного подключения без интерфейса (сервис).
        "app": "medcard",

		// Наименование конфигурации, отображающееся пользователю при выборе, а
        // также в заголовке главного окна программы и закладке браузера.
        // Если не указано, то возьмется из наименования задачи в
        // параметре "app".
		"title": "Медицинская информационная система",

        // Разрешенные задачи и группы задач для данной конфигурации. Указываются
        // через пробелы, запятые, или точки с запятой. Группа разрешает все
        // вложенные группы и задачи каскадно. Древо задач и групп смотреть в
        // cfg/apps.txt. Если не указано, то включаются задачи, связанные со
        // стартовой, указанной в параметре "app".
        "enableApps": "",

        // Запрещенные задачи и группы задач для данной конфигурации. Имеет
        // приоритет над "enableApps". Указываются через пробелы, запятые, или
        // точки с запятой. Группа запрещает все вложенные группы и задачи
        // каскадно. Древо задач и групп смотреть в cfg/apps.txt. Если не
        // указано, то включаются задачи, связанные со стартовой,
        // указанной в параметре "app".
        "disableApps": "",

        // Разрешение конфигурации при доступе с указанных доменных имен.
        // Указывается в виде регулярного выражения, например:
        // "gateway.office4.foo", "(client1.mis.by|client2.mis.by)".
        "enableDomains": "",

        // Отключение конфигурации при доступе с указанных доменных имен.
        // Имеет приоритет над "disableApps".
        // Указывается в виде регулярного выражения, например:
        // "gateway.office4.foo", "(client1.mis.by|client2.mis.by)".
        "disableDomains": "",

        // Настройки основного подключения к базе данных приложения.
        // Пример строки подключения для Sybase:
        //  "asa:Driver={Adaptive Server Anywhere 9.0};ENG=mapsrv;DBN=mapdb;LINKS=ShMem,TCP{};CS=utf8;UID=map;PWD=pam"
        "connect": "pgsql:host=127.0.0.1;port=5432;dbname=meddb;user=map;password=pam",

		// Время в секундах, которое клиентское приложение должно ожидать
        // запрос от сервера. По умолчанию 30 секунд. При низких технических
        // характеристиках сервера и ресурсоемких задач необходимо увеличить.
        "timeout": 30,

		// Запретить запоминать пользовательский пароль при авторизации для
		// выполнения автоматического входа.
		"noAutoLogin": false,

        // Местоположение исполняемого файла МАП.
        // Используется для генерации отчетов в приложениях на основе БД МАП.
        "mapBin": "d:\\MAPSOFT\\MAP\\Bin",

		// Настройка для удаленной генерации отчетов
		"remoteReport": {
			 "active": "0",  /* если 1 - генерируем отчет удаленно 0 - у себя на сервере */
			 "host": "http://127.0.0.1:8080", /* адрес хоста удаленного сервера генерации отчетов */
			 "mapDbAlias": "mapdb" /* Название подкючения к базе в МАП из которой будет сгенерирован отчет */
		}

        // Настройка вьювера DICOM-снимков
        // * dicomViewer - тип вьювера (по умолчанию - osimis):
        //   * osimis - HTML-вьювер Osimis встроенный в локальный PACS Orthanc
        //   * generic - HTML-вьювер, настроенный в конфиге (dicomViewerUrl)
        // * dicomViewerUrl - ссылка на внешний вьювер, в ссылку подставляется
        //     идентификатор инстанса исследования в PACS, в макро-параметр {studyInstanceId}.
        //
        // Пример:
        // "dicomViewer": "generic",
        // "dicomViewerUrl": "http://127.0.0.1:8042/stone-webviewer/index.html?study={studyInstanceId}"
    }
}