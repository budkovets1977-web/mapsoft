            "Alias": "Цены_прошлые",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "PricePgSQL",
        "SqlCommand": "SELECT\r\n  CASE COALESCE(Enterprise1.FullName, E'' )= E'' WHEN true THEN Enterprise1.Name WHEN false THEN Enterprise1.FullName END as Field1,\r\n fn_pmsMatWealthName( pmsWealthPrice1.MatWealthCode ) as Field2,\r\n pmsWealthPrice1.DocumentNumber as Field3,\r\n DATEFORMAT(pmsWealthPrice1.DocumentDate, 'dd.mm.yyyy') as Field4,\r\n pmsWealthPrice1.InvoicePrice as Field5,\r\n pmsWealthPrice1.WholesalePercent as Field6,\r\n pmsWealthPrice1.ProducerPrice as Field7,\r\n pmsWealthPrice1.TradingPercent as Field8,\r\n pmsWealthPrice1.TradingPrice as Field9,\r\n pmsWealthPrice1.VATrate as Field10,\r\n pmsWealthPrice1.PriceWithVAT as Field11,\r\n pmsWealthPrice1.RetailRatio as Field12,\r\n pmsWealthPrice1.Price as Field13,\r\n pmsWealthPrice1.VAT as Field14,\r\n pmsWealthPrice1.TradingCost as Field15,\r\n COALESCE(pmsWealthPrice2.Price, 0) as Field16,\r\n DATEFORMAT(@На_дату, 'dd.mm.yyyy') as Field17\r\nFROM\r\n Enterprise as Enterprise1\r\nJOIN pmsWealthPrice as pmsWealthPrice1 ON pmsWealthPrice1.EnterpriseCode = Enterprise1.EnterpriseCode AND pmsWealthPrice1.EnterpriseStructureCode = @Подразделение AND ((@Только_изменения = 1 AND pmsWealthPrice1.OnDate = @На_дату) OR (@Только_изменения = 0 AND pmsWealthPrice1.OnDate = (Select MAX(OnDate) from pmswealthprice Where enterprisecode = @Организация AND enterprisestructurecode = @Подразделение AND matWealthCode = pmsWealthPrice1.MatWealthCode AND OnDate <= @На_дату)))\r\n LEFT OUTER JOIN MatWealth as MatWealth1 ON MatWealth1.MatWealthCode = pmsWealthPrice1.MatWealthCode\r\nLEFT OUTER JOIN pmsWealthPrice AS pmsWealthPrice2 ON pmsWealthPrice2.EnterpriseCode = Enterprise1.EnterpriseCode AND pmsWealthPrice2.EnterpriseStructureCode = @Подразделение AND pmsWealthPrice2.pmsWealthPriceCode = (SELECT pwp.pmswealthpriceCode FROM pmswealthprice AS pwp where pwp.OnDate = (SELECT MAX(pwp1.OnDate) FROM pmswealthprice AS pwp1 WHERE COALESCE( pwp1.EnterpriseStructureCode, 0) = @Подразделение AND pwp1.OnDate < pmsWealthPrice1.OnDate AND pwp1.matwealthcode = pmsWealthPrice1.MatWealthCode) AND COALESCE( pwp.EnterpriseStructureCode, 0) = @Подразделение AND pwp.matwealthcode = pmsWealthPrice1.MatWealthCode  LIMIT 1 )\r\nWHERE\r\n Enterprise1.EnterpriseCode = @Организация\r\n AND COALESCE( pmsWealthPrice1.Active,0) = 1\r\nGROUP BY\r\n Field1, Field2, Field4, Field5, Field6, Field7, Field8, Field3, Field9, Field10, Field11, Field12, Field13, Field14, Field15, Field16, Field17\r\nORDER BY\r\n 1 ASC, 2 ASC"
      },
      "1": {
        "Ident": "StiPostgreSQLSource",
        "Name": "Подписи",
        "Alias": "Подписи",
        "Key": "2f9933a2d90c49f3b07919a3706a6d9e",
        "Columns": {
          "0": {
