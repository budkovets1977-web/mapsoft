            "Index": -1,
            "NameInSource": "field4",
            "Alias": "Должность_руководителя",
            "Type": "System.String"
          }
        },
        "NameInSource": "PricePgSQL",
        "SqlCommand": "SELECT\r\n\tfn_cmFIO( WorkerInfo1.ManCode, 2 ) as Field1,\r\n\tWorkerInfo1.PostName as Field2,\r\n\tfn_cmFIO( WorkerInfo2.ManCode, 2) as Field3,\r\n\tWorkerInfo2.PostName as Field4\r\n\tFROM\r\n\tEnterprise AS Enterprise1 LEFT OUTER JOIN Worker AS Worker1 ON Worker1.EnterpriseCode = Enterprise1.EnterpriseCode AND Worker1.WorkerCode = @Исполнитель\r\n LEFT OUTER JOIN WorkerInfo AS WorkerInfo1 ON WorkerInfo1.WorkerCode = Worker1.WorkerCode\r\n LEFT OUTER JOIN Worker AS Worker2 ON Worker2.EnterpriseCode = Enterprise1.EnterpriseCode AND Worker2.WorkerCode = @Руководитель\r\n LEFT OUTER JOIN WorkerInfo AS WorkerInfo2 ON WorkerInfo2.WorkerCode = Worker2.WorkerCode\r\nWHERE\r\n Enterprise1.EnterpriseCode = @Организация\r\nORDER BY\r\n 1 ;\r\n"
      }
    },
