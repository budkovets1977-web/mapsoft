        "NameInSource": "PricePgSQL",
        "Type": "Table",
        "SqlCommand": "SELECT\r\n\tCASE COALESCE(Enterprise1.FullName, E'' )= E'' WHEN true THEN Enterprise1.Name WHEN false THEN Enterprise1.FullName END as Field1,\r\n pmsPricelist1.pmsPricelistCode as Field2,\r\n pmsPricelist1.Name as Field3,\r\n pmsPricelist1.FullCode as Field4,\r\n fn_pmsMatWealthName( pmsPricelistWealth1.matWealthCode ) as Field5,\r\n pmsPricelistSum1.Tariff as Field6,\r\n pmsPricelistSum1.MaterialSum as Field7,\r\n pmsPricelistSum1.AsideServiceSum as Field8,\r\n pmsPricelistSum1.serviceprice as Field9,\r\n pmsPricelist1.Kind as Field10,\r\n pmsPricelistKind1.Name as Field11,\r\n pmsWealthPrice1.Price*COALESCE(pmsPricelistWealth1.Amount, 1) as Field12,\r\n DATEFORMAT(@На_дату, 'dd.mm.yyyy') as Field13,\r\n pmsPricelist1.SortCode as Field14\r\nFROM\r\n Enterprise AS Enterprise1 JOIN pmsPricelistKind AS pmsPricelistKind1 ON pmsPricelistKind1.EnterpriseCode = Enterprise1.EnterpriseCode\r\n JOIN pmsPricelist AS pmsPricelist1 ON pmsPricelist1.pmsPricelistKindCode = pmsPricelistKind1.pmsPricelistKindCode AND COALESCE( pmsPricelist1.Active, 0 ) = 1\r\n LEFT OUTER JOIN pmsPricelistWealth AS pmsPricelistWealth1 ON pmsPricelistWealth1.pmsPricelistCode = pmsPricelist1.pmsPricelistCode AND COALESCE( pmsPricelistWealth1.Active,0) = 1 AND COALESCE( pmsPricelistWealth1.Kind,0) = 1\r\nLEFT OUTER JOIN pmsPricelistSum AS pmsPricelistSum1 ON pmsPricelistSum1.pmsPricelistCode = pmsPricelist1.pmsPricelistCode AND pmsPricelistSum1.OnDate = (Select MAX(OnDate) from pmspricelistsum Where pmspricelistcode = pmsPricelist1.pmsPricelistCode AND OnDate <= (@На_дату))\r\nLEFT OUTER JOIN MatWealth as MatWealth1 ON MatWealth1.MatWealthCode = pmsPricelistWealth1.matWealthCode\r\nLEFT JOIN lateral (\r\n    select \r\n\t pwp.pmsWealthPriceCode,\r\n     pwp.Price\r\n    from pmsWealthPrice AS pwp\r\n    where pwp.EnterpriseCode = @Организация \r\n\tAND pwp.EnterpriseStructureCode = @Подразделение \r\n\tAND pwp.MatWealthCode IN (\r\n\t    select MatWealthCode \r\n\t\tfrom MatWealth\r\n\t\twhere MatWealthObjectCode = MatWealth1.MatWealthObjectCode\r\n\t\tand Active = 1)\r\n\tAND pwp.OnDate = (Select MAX(OnDate) from pmswealthprice Where enterprisecode = @Организация AND enterprisestructurecode = @Подразделение AND matwealthcode = pwp.matWealthCode AND OnDate <= (@На_дату))\r\n\torder by pwp.pmsWealthPriceCode\r\n\tlimit 1) as pmsWealthPrice1 on True\r\nWHERE\r\n Enterprise1.EnterpriseCode = @Организация\r\n AND COALESCE( pmsPricelistKind1.Active,0) = 1\r\n AND pmsPricelistKind1.pmsPricelistKindCode = @Прейскурант\r\nGROUP BY\r\n 1, 4, 10, 11, 5, 3, 6, 2, 7, 8, 9, 12, 13\r\nORDER BY\r\n 1 , 11 , 4 , 3 , 5 ;"
      },
      "1": {
        "Ident": "StiPostgreSQLSource",
