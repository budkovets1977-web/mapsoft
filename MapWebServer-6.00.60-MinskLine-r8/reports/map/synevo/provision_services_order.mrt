          }
        },
        "NameInSource": "SynevoDB1",
        "SqlCommand": "SELECT map.enterprise.enterprisecode\r\n\tFROM map.enterprise\r\n\twhere map.enterprise.enterprisecode = :Организация\r\nLIMIT 1"
      },
      "4": {
        "Ident": "StiPostgreSQLSource",
        "Name": "SelectOrder",
        "Alias": "ВыборЗаказа",
        "Key": "a91f0a60eda94befa5db7a8a5c2886b9",
        "Columns": {
          "0": {
            "Name": "logcode",
            "Index": -1,
            "NameInSource": "logcode",
            "Alias": "logcode",
            "Type": "System.Int32",
            "Key": "16ec5141df2c45c6a7575d4edea8adb3"
          },
          "1": {
            "Name": "logname",
            "Index": -1,
            "NameInSource": "logname",
            "Alias": "logname",
            "Type": "System.String",
            "Key": "8693b7ab66ce4b309e42b12c8e736532"
          }
        },
        "NameInSource": "EnterOrder",
        "SqlCommand": "SELECT\r\n\tmap.synevologservice.synevologservicecode as LogCode,\r\n\t'№' + map.synevologservice.documentnumber + ' от ' + DATEFORMAT(map.synevologservice.documentdate,  E'dd.mm.yyyy' ) as LogName\r\nFROM map.synevologservice \r\nJOIN map.medcabinet ON map.synevologservice.medcabinetcode = map.medcabinet.medcabinetcode\r\nLEFT OUTER JOIN map.medpatient ON map.synevologservice.medpatientcode = map.medpatient.medpatientcode\r\nLEFT OUTER JOIN map.manpassport ON map.manpassport.ManCode = map.medpatient.ManCode\r\nLEFT OUTER JOIN map.webuser ON map.webuser.webusercode = map.synevologservice.webusercode\r\nLEFT OUTER JOIN map.Enterprise ON map.Enterprise.EnterpriseCode = map.synevologservice.EnterpriseCode\r\nWHERE map.synevologservice.enterprisecode = :Организация\r\nAND DATE(map.synevologservice.visittime) = :На_дату\r\nAND map.synevologservice.synevologservicecode <> 0\r\nAND (EXISTS(SELECT slr.synevologservicerowcode FROM map.synevologservicerow as slr WHERE slr.synevologservicecode = map.synevologservice.synevologservicecode)\r\nOR COALESCE(map.synevologservice.paymentsum, 0)<>(0))\r\nORDER BY\r\nLogName asc"
      }
    },
