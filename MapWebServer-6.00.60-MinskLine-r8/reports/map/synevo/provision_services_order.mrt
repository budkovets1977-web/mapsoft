            "Alias": "name",
            "Type": "System.String",
            "Key": "8866dfaae53f4ea2818f3ee203bf3127"
          }
        },
        "NameInSource": "EnterEnterprise",
        "SqlCommand": "SELECT map.enterprise.enterprisecode as Code, \r\n\tmap.enterprise.name as Name\r\n\tFROM map.enterprise\r\n\tWHERE map.enterprise.enterprisecode <> 0\r\n\tORDER BY map.enterprise.name"
      },
      "2": {
        "Ident": "StiPostgreSQLSource",
        "Name": "SynevoPatientService",
        "Alias": "Список услуг",
        "Key": "750c275094294f2688e33013708bbd45",
