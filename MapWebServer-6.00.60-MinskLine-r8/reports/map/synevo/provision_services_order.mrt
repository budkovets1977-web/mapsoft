            "NameInSource": "result",
            "Alias": "result",
            "Type": "System.Decimal"
          }
        },
        "NameInSource": "SynevoDB1",
        "SqlCommand": "SELECT \r\n\tmap.synevologservice.synevologservicecode as LogCode,\r\n\tmap.synevologservicerow.synevologservicerowcode as ServCode,\r\n\tmap.synevologservicerow.servicename as ServName,\r\n    map.synevologservicerow.serviceprice as Price,\r\n\tmap.synevologservicerow.serviceamount as Amount,\r\n\tmap.synevologservicerow.resultsum as Result\r\nFROM map.synevologservice \r\nJOIN map.synevologservicerow ON map.synevologservicerow.synevologservicecode =  map.synevologservice.synevologservicecode\r\nWHERE\r\nmap.synevologservice.enterprisecode = :Организация\r\nAND map.synevologservice.synevologservicecode = :Заказ\r\nOrder by\r\nLogCode, ServName asc"
      },
      "3": {
        "Ident": "StiPostgreSQLSource",
        "Name": "EmptyRow",
        "Alias": "Пустая строка",
        "Key": "ef68f1a86d1c4fb0936a9b2ca015a440",
        "Columns": {
          "0": {
            "Name": "enterprisecode",
