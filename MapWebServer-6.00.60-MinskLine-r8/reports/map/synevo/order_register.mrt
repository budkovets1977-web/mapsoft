      <SynevoPatientList Ref="4" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>Список пациентов</Alias>
        <Columns isList="true" count="17">
          <value>ORIGINAL,entcode,entcode,entcode,System.Int32,_x0037_9ddd08dffcf4568936b3883d40e998e</value>
          <value>entname,System.String</value>
          <value>ORIGINAL,logcode,logcode,logcode,System.Int32,dbe0557752af4f838361e26b8525e5b5</value>
          <value>datenum,System.String</value>
          <value>datedoc,System.String</value>
          <value>ORIGINAL,visdate,visdate,visdate,System.String,b94e3f6c86064de19a53f354b1280d0e</value>
          <value>vistime,System.String</value>
          <value>cabname,System.String</value>
