          <value>birthdate,System.String</value>
          <value>adress,System.String</value>
          <value>telefon,System.String</value>
          <value>nickname,System.String</value>
          <value>summ,System.Decimal</value>
          <value>paymentsum,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>ac3332c9b94f43ecbacde606a129409d</Key>
        <Name>SynevoPatientList</Name>
        <NameInSource>SynevoDB1</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	map.synevologservice.enterprisecode as EntCode,
	COALESCE( NULLIF( map.Enterprise.FullName,  E'' ), map.Enterprise.Name ) as EntName,
	map.synevologservice.synevologservicecode as LogCode,
	map.synevologservice.documentnumber as DateNum,
	DATEFORMAT(map.synevologservice.documentdate,  E'dd.mm.yyyy' ) as DateDoc,
    DATEFORMAT(map.synevologservice.visittime,  E'dd.mm.yyyy' ) as VisDate,
	DATEFORMAT(map.synevologservice.visittime,  E'hh:mm' ) as VisTime,
    map.medcabinet.cabinet as CabName,
    map.synevologservice.doctorfio as Maker,
    map.synevologservice.Note as Note,
    CASE COALESCE(map.synevologservice.medpatientcode, 0)&lt;&gt;(0 )WHEN true THEN FN_cmFIO(map.medpatient.ManCode) WHEN false THEN map.synevologservice.patientfio END as FIO,
    COALESCE( DATEFORMAT( NULLIF( map.manpassport.DateOfBirth , DATE(  E'1899-12-31' )),  E'dd.mm.yyyy' ),  E' н/у' ) as BirthDate,
    FN_cmCalcAddress( map.synevologservice.medpatientcode , 4, 1, 1 ) as adress,
    (SELECT string_agg((Q.PhType || Q.PhNum)::text,  E'; ' ORDER BY Q.PhType )
      FROM
     (SELECT CASE MP.PhoneType = 1 WHEN true THEN  E'д.т. ' WHEN false THEN CASE MP.PhoneType = 2 WHEN true THEN  E'р.т. ' WHEN false THEN  E'м.т. ' END END as PhType, string_agg((MP.PhoneNumber )::text, ',' ) as PhNum
         FROM ManPhone AS MP WHERE MP.ManCode = map.synevologservice.medpatientcode AND MP.PhoneNumber &lt;&gt; ( E'' )GROUP BY 1
        ORDER BY 1) AS Q) as Telefon,
    map.webuser.nick as NickName,
    map.synevologservice.summ, 
    map.synevologservice.paymentsum
FROM map.synevologservice 
JOIN map.medcabinet ON map.synevologservice.medcabinetcode = map.medcabinet.medcabinetcode
LEFT OUTER JOIN map.medpatient ON map.synevologservice.medpatientcode = map.medpatient.medpatientcode
LEFT OUTER JOIN map.manpassport ON map.manpassport.ManCode = map.medpatient.ManCode
LEFT OUTER JOIN map.webuser ON map.webuser.webusercode = map.synevologservice.webusercode
LEFT OUTER JOIN map.Enterprise ON map.Enterprise.EnterpriseCode = map.synevologservice.EnterpriseCode
WHERE map.synevologservice.enterprisecode = {Enterprise}
AND DATE(map.synevologservice.visittime) = DATE('{DateRecord}')
AND (EXISTS(SELECT slr.synevologservicerowcode FROM map.synevologservicerow as slr WHERE slr.synevologservicecode = map.synevologservice.synevologservicecode)
OR COALESCE(map.synevologservice.paymentsum, 0)&lt;&gt;(0))
ORDER BY
map.synevologservice.enterprisecode asc, map.synevologservice.visittime asc, map.medcabinet.medcabinetcode asc</SqlCommand>
      </SynevoPatientList>
      <EnterEnterprise Ref="5" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>Выбор организации</Alias>
        <Columns isList="true" count="2">
          <value>ORIGINAL,code,code,code,System.Int32,_x0035_4c4a9fe9cad4839a21e32b3d40d0f4b</value>
          <value>ORIGINAL,name,name,name,System.String,_x0038_866dfaae53f4ea2818f3ee203bf3127</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>ca5675ebea104ab389834a77dd945c33</Key>
        <Name>EnterEnterprise</Name>
        <NameInSource>EnterEnterprise</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT map.enterprise.enterprisecode as Code, 
	map.enterprise.name as Name
	FROM map.enterprise
	WHERE map.enterprise.enterprisecode &lt;&gt; 0
	ORDER BY map.enterprise.name</SqlCommand>
      </EnterEnterprise>
      <SynevoPatientService Ref="6" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>Список услуг</Alias>
        <Columns isList="true" count="6">
          <value>logcode,System.Int32</value>
          <value>servcode,System.Int32</value>
          <value>servname,System.String</value>
          <value>price,System.Decimal</value>
          <value>amount,System.Decimal</value>
          <value>result,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>750c275094294f2688e33013708bbd45</Key>
        <Name>SynevoPatientService</Name>
        <NameInSource>SynevoDB1</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	map.synevologservice.synevologservicecode as LogCode,
	map.synevologservicerow.synevologservicerowcode as ServCode,
	map.synevologservicerow.servicename as ServName,
    map.synevologservicerow.serviceprice as Price,
	map.synevologservicerow.serviceamount as Amount,
	map.synevologservicerow.resultsum as Result
FROM map.synevologservice 
JOIN map.synevologservicerow ON map.synevologservicerow.synevologservicecode =  map.synevologservice.synevologservicecode
WHERE
DATE(map.synevologservice.visittime) = DATE('{DateRecord}')
AND map.synevologservice.enterprisecode = {Enterprise}
Order by
LogCode, ServName asc</SqlCommand>
      </SynevoPatientService>
