# ============================================================================
#  МинскЛайн — Apache configuration
#  Оптимизация производительности: кеширование, сжатие, заголовки.
# ============================================================================

# ----------------------------------------------------------------------------
#  1. Сжатие (Compression)
#     Отдаём текстовые ресурсы в gzip/brotli — экономия до ~70% трафика.
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Принудительно включаем сжатие для всех сжимаемых типов
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf

    # Brotli — если модуль установлен, он перекрывает gzip по умолчанию
    <IfModule mod_brotli.c>
        AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
        AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
        AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
        AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
    </IfModule>

    # HTML уже сжат PHP-расширением? Не пересжимаем дважды
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE "enabl ed" "no-gzip dont-vary"
    </IfModule>
</IfModule>

# Не сжимаем уже сжатые форматы
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
    AddType font/woff2 .woff2
    AddType application/font-woff .woff
    AddType text/javascript .js .mjs
    AddType application/manifest+json .webmanifest

    # The Font Awesome rewrite that used to live here
    # (^css/fonts/... -> css/fontawesome-webfont.$2) is gone: the .fa-* glyphs
    # are inline SVG masks in css/icons-2026.css, so the site loads no webfont
    # at all and the css/fonts directory has been removed.
</IfModule>

# ----------------------------------------------------------------------------
#  2. Кеширование в браузере (Browser caching)
#
#     БЫЛО: no-store/no-cache для ВСЕГО (.html|.js|.css) — каждый визит
#     означал полную повторную загрузку страницы, стилей и скриптов.
#     СТАЛО: контент — revalidate (быстрый 304), статика — immutable на год.
# ----------------------------------------------------------------------------

# Контент, зависящий от запроса — проверять, но отдавать через 304
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    # Документы и динамика: короткий TTL + ETag/Last-Modified
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/xhtml+xml     "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"

    # Статика: кешируем на год. Файлы версионируются хешем в имени либо
    # обновляются редко; принудительный сброс — Ctrl+F5 / Clear-Site-Data.
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType application/x-javascript  "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType audio/mpeg                "access plus 1 month"
    ExpiresByType video/mp4                 "access plus 1 month"
</IfModule>

# ----------------------------------------------------------------------------
#  3. Cache-Control / ETag
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # 304-ревалидация вместо полной загрузки
    Header always set Cache-Control "public, max-age=0, must-revalidate" env=REDIRECT_STATUS_DEFAULT

    # Статика: иммутабельный кеш на год
    <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML/PHP: всегда сверяться с сервером, но не хранить устаревшую копию
    <FilesMatch "\.(html?|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>

    # --- Производительность и безопасность ---
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    Header always set X-DNS-Prefetch-Control "off"

    # Не отдавать версию Apache и PHP
    Header unset X-Powered-By
    ServerSignature Off
</IfModule>

<IfModule mod_mime.c>
    # Правильные MIME-типы, чтобы браузер не делал «strict MIME checking» ошибок
    AddDefaultCharset UTF-8
</IfModule>

# ----------------------------------------------------------------------------
#  4. Лимиты и защита
# ----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

DirectoryIndex index.php index.html
Options -Indexes -MultiViews
<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On
    RewriteBase /

    # --- ЧПУ: f123-..., t1-f2-... --------------------------------------------
    #
    # /nav/ (служебная навигация со своим секретом) из правил ЧПУ исключена:
    # у неё свой .htaccess, и правила ниже не должны перехватывать
    # /nav/<секрет>/ раньше него.
    #
    # Именно <If "%{REQUEST_URI} !~ ...">, а не "RewriteRule ^nav/ - [L]":
    # пассквоз с [L] остановил бы всю цепочку и до редиректа на HTTPS
    # (ниже) дело бы не дошло — /nav/ открывался бы по http.
    # <If> доступен с Apache 2.4; 2.4 тут гарантирован правилом
    # "Require all denied" в самом низу этого файла.
    <If "%{REQUEST_URI} !~ m#^/nav/#">
        RewriteRule ^.*[-/]f(\d+)-.*$ index\.php?id=$1&%{QUERY_STRING} [L]
        RewriteRule ^f(\d+)-.*$ index\.php?id=$1&%{QUERY_STRING} [L]
        RewriteRule ^t(\d+)[-/].*[-/]f(\d+)-.*$ index\.php?id=$1-$2&%{QUERY_STRING} [L]
        RewriteRule ^t(\d+)[-/]f(\d+)[-/].*$ index\.php?id=$1-$2&%{QUERY_STRING} [L]
        RewriteRule ^f(\d+)[-/].*[-/]t(\d+)[-/].*$ index\.php?id=$2-$1&%{QUERY_STRING} [L]
        RewriteRule ^f(\d+)[-/]t(\d+)[-/].*$ index\.php?id=$2-$1&%{QUERY_STRING} [L]
        RewriteRule ^.*[-/]f(\d+)[-/]t(\d+)[-/].*$ index\.php?id=$2-$1&%{QUERY_STRING} [L]
        RewriteRule ^.*[-/]f(\d+)[-/].*[-/]t(\d+)[-/].*$ index\.php?id=$2-$1&%{QUERY_STRING} [L]
        RewriteRule ^.*[-/]t(\d+)[-/].*[-/]f(\d+)[-/].*$ index\.php?id=$1-$2&%{QUERY_STRING} [L]
        RewriteRule ^.*[-/]t(\d+)[-/]f(\d+)[-/].*$ index\.php?id=$1-$2&%{QUERY_STRING} [L]

        # --- Редиректы алиасов на главную ---------------------------------------
        RewriteCond %{HTTP_HOST} ^minskline\.by$ [OR]
        RewriteCond %{HTTP_HOST} ^www\.minskline\.by$
        RewriteRule ^single2\.html$ "https://minskline.by/" [R=301,L]

        RewriteCond %{HTTP_HOST} ^xn\-\-\-\-9sba3adgcokdxnfu\.xn\-\-90ais$ [OR]
        RewriteCond %{HTTP_HOST} ^www\.xn\-\-\-\-9sba3adgcokdxnfu\.xn\-\-90ais$
        RewriteRule ^/?$ "https://minskline.by/" [R=301,L]

        RewriteCond %{HTTP_HOST} ^minskline\.by$ [OR]
        RewriteCond %{HTTP_HOST} ^www\.minskline\.by$
        RewriteRule ^contact\.html$ "https://minskline.by/" [R=301,L]
    </If>
</IfModule>

# ----------------------------------------------------------------------------
#  5. HTTPS
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ----------------------------------------------------------------------------
#  6. Служебные файлы
# ----------------------------------------------------------------------------
<FilesMatch "^\.(htaccess|htpasswd|env|git.*|log_app\.txt)$">
    Require all denied
</FilesMatch>

# Внутренняя документация проекта: read.md и session.txt. Без этого правила
# они отдавались публично на https://minskline.by/read.md — вместе с
# внутренними комментариями, описанием API и списком ловушек. Список явный,
# а не "\.md$": на случай, если появится служебный .md, который отдавать надо.
<FilesMatch "^(read\.md|session\.txt)$">
    Require all denied
</FilesMatch>
